# ==============================================================================
# RecallBox Configuration Example (.env.example)
# ==============================================================================
# All defaults are designed to run 100% locally with zero external API calls.
# Copy this file to .env to customize settings: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network Configuration
# ------------------------------------------------------------------------------
# RECALLBOX_HOST: Loopback binding (127.0.0.1) prevents exposure to local network.
# Change to 0.0.0.0 only if intentionally hosting on a private LAN or Docker host.
RECALLBOX_HOST=127.0.0.1
RECALLBOX_PORT=8765

# ------------------------------------------------------------------------------
# 2. Local Authentication Token (Optional Override)
# ------------------------------------------------------------------------------
# RECALLBOX_API_KEY: By default, RecallBox generates a cryptographically random
# 32-byte hex token in `data/auth_token` on first startup. You can optionally
# override it here with a custom secret token (minimum 16 characters).
# SECURITY IMPACT: Required for accessing protected memory CRUD and search endpoints.
RECALLBOX_API_KEY=

# ------------------------------------------------------------------------------
# 3. AI Provider Selection
# ------------------------------------------------------------------------------
# RECALLBOX_AI_PROVIDER:
#   - "local"  (DEFAULT): 100% offline, zero-token extractive text analyzer & vector index.
#   - "ollama" : Connects to your local Ollama instance (e.g. llama3.2, nomic-embed-text).
#   - "openai" : Connects to OpenAI, Groq, DeepSeek, vLLM, or any OpenAI-compatible API.
RECALLBOX_AI_PROVIDER=local

# ------------------------------------------------------------------------------
# 4. Ollama Configuration (Only used when RECALLBOX_AI_PROVIDER=ollama)
# ------------------------------------------------------------------------------
RECALLBOX_OLLAMA_URL=http://127.0.0.1:11434
RECALLBOX_OLLAMA_MODEL=llama3.2
RECALLBOX_OLLAMA_EMBED_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 5. Cloud AI Provider Configuration (Only used when RECALLBOX_AI_PROVIDER=openai)
# ------------------------------------------------------------------------------
# SECURITY IMPACT: If set, memory summaries and query embeddings are transmitted
# over TLS to this endpoint. Never commit real API keys to version control.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 6. Model Context Protocol (MCP) Security
# ------------------------------------------------------------------------------
# RECALLBOX_MCP_ALLOW_DESTRUCTIVE: Gating flag for destructive MCP tool invocations
# (e.g. `forget` tool). Defaults to false to prevent indirect prompt injection attacks.
# SECURITY IMPACT: HIGH. Set to true only if you explicitly trust connected MCP clients.
RECALLBOX_MCP_ALLOW_DESTRUCTIVE=false
