{
  "name": "recallbox-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first personal memory system that remembers why you saved something — with hybrid search, knowledge graphs, browser capture, CLI, and MCP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTAKUWeBer/RecallBox.git"
  },
  "homepage": "https://github.com/OTAKUWeBer/RecallBox",
  "bugs": {
    "url": "https://github.com/OTAKUWeBer/RecallBox/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --cwd apps/web dev",
    "build:web": "bun --cwd apps/web build",
    "build:ext": "bun --cwd apps/extension build",
    "mcp": "bun --cwd packages/mcp start"
  },
  "keywords": [
    "recallbox",
    "local-first",
    "personal-knowledge-management",
    "knowledge-management",
    "privacy",
    "ai",
    "memory",
    "second-brain",
    "sqlite",
    "fastapi",
    "react",
    "typescript",
    "python",
    "mcp",
    "browser-extension",
    "opensource"
  ],
  "author": "RecallBox Community",
  "license": "MIT"
}
